sunset:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('PGHOST','localhost') }}"
      port: "{{ env_var('PGPORT','5432') | int }}"
      user: "{{ env_var('PGUSER','sunset') }}"
      password: "{{ env_var('PGPASSWORD') }}"
      dbname: "{{ env_var('PGDATABASE','sunset') }}"
      schema: public
      threads: 2
